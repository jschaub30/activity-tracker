# Copy to .env and fill in values
SECRET_KEY=replace-with-long-random-string
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Local DynamoDB (mise run dynamodb). boto3 uses dummy keys automatically
# when DYNAMODB_ENDPOINT is set — do not put AWS_ACCESS_KEY_ID in this file.
DYNAMODB_TABLE=garmin-tracker
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
AWS_REGION=us-west-2

SYNC_BACKEND=inline
DATA_BUCKET=
ORIGIN_SECRET=

DEFAULT_TIMEZONE=America/Denver
BACKFILL_DAYS=365
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
DEBUG=true
